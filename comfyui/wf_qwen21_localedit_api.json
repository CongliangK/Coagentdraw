{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
   "weight_dtype": "default"
  }
 },
 "cache": {
  "class_type": "QwenImage21Cache",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "device": "auto",
   "dtype": "default"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
   "type": "qwen_image",
   "device": "default"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
  }
 },
 "load1": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "cwb_cs_base.png"
  }
 },
 "loadmask": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "cwb_cs_mask.png"
  }
 },
 "tomask": {
  "class_type": "ImageToMask",
  "inputs": {
   "image": [
    "loadmask",
    0
   ],
   "channel": "red"
  }
 },
 "crop": {
  "class_type": "InpaintCropImproved",
  "inputs": {
   "image": [
    "load1",
    0
   ],
   "mask": [
    "tomask",
    0
   ],
   "downscale_algorithm": "bilinear",
   "upscale_algorithm": "bicubic",
   "preresize": false,
   "preresize_mode": "ensure minimum resolution",
   "preresize_min_width": 1024,
   "preresize_min_height": 1024,
   "preresize_max_width": 16384,
   "preresize_max_height": 16384,
   "mask_fill_holes": true,
   "mask_expand_pixels": 50,
   "mask_invert": false,
   "mask_blend_pixels": 32,
   "mask_hipass_filter": 0.1,
   "extend_for_outpainting": false,
   "extend_up_factor": 1,
   "extend_down_factor": 1,
   "extend_left_factor": 1,
   "extend_right_factor": 1,
   "context_from_mask_extend_factor": 1.2,
   "output_resize_to_target_size": true,
   "output_target_width": 768,
   "output_target_height": 768,
   "output_padding": "32",
   "device_mode": "cpu (compatible)"
  }
 },
 "encode": {
  "class_type": "TextEncodeQwenImage21",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "prompt": "Edit only the area inside the white disk of <image2>: describe the intended change here. Everything outside the disk must stay exactly as in <image1>.",
   "negative_prompt": "",
   "vae": [
    "vae",
    0
   ],
   "resolution": 0,
   "images": {
    "image_1": [
     "load1",
     0
    ],
    "image_2": [
     "loadmask",
     0
    ]
   }
  }
 },
 "vaeenc": {
  "class_type": "VAEEncode",
  "inputs": {
   "pixels": [
    "crop",
    1
   ],
   "vae": [
    "vae",
    0
   ]
  }
 },
 "setmask": {
  "class_type": "SetLatentNoiseMask",
  "inputs": {
   "samples": [
    "vaeenc",
    0
   ],
   "mask": [
    "crop",
    2
   ]
  }
 },
 "sampler": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "cache",
    0
   ],
   "seed": 42,
   "steps": 25,
   "cfg": 1.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "denoise": 1.0,
   "positive": [
    "encode",
    0
   ],
   "negative": [
    "encode",
    1
   ],
   "latent_image": [
    "setmask",
    0
   ]
  }
 },
 "decode": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "sampler",
    0
   ],
   "vae": [
    "vae",
    0
   ]
  }
 },
 "stitch": {
  "class_type": "InpaintStitchImproved",
  "inputs": {
   "stitcher": [
    "crop",
    0
   ],
   "inpainted_image": [
    "decode",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "stitch",
    0
   ],
   "filename_prefix": "qwen21_localedit"
  }
 }
}